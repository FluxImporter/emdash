---
// Docs page header (GuidePage.dc.html, EmDash.dc.html): breadcrumb, title with an optional status
// pill, and an optional lede. Splash pages (home, 404) render their own <h1> in the page body.
import type { StarlightRouteData } from "@astrojs/starlight/route-data";
import { EMDASH_VERSION } from "../site";

type Entry = StarlightRouteData["sidebar"][number];

const route = Astro.locals.starlightRoute;
const { title, template, lede, status } = route.entry.data;
const splash = template === "splash";

// Group labels on the way to the current sidebar link, and that link's label. A page outside
// the sidebar has its parent marked current (src/starlightRouteData.ts).
function trail(entries: Entry[], groups: string[] = []): string[] | undefined {
	for (const entry of entries) {
		if (entry.type === "link" && entry.isCurrent) return [...groups, entry.label];
		if (entry.type === "group") {
			const found = trail(entry.entries, [...groups, entry.label]);
			if (found) return found;
		}
	}
	return undefined;
}

const PRODUCTS: Record<string, string> = { emdash: "EmDash", wordpress: "WordPress" };
const path = Astro.url.pathname;
const product = PRODUCTS[path.split("/")[1] ?? ""];
const found = trail(route.sidebar);
let crumbs: string[] = [];
if (product && found && found.length > 1) {
	const page = found.at(-1);
	// The page's own label only when it says something the title doesn't.
	crumbs = [product, ...found.slice(0, -1), ...(page && page !== title ? [page] : [])];
}
// API route pages (/emdash/reference/api/<group>/<route>/) set their title, the route, in mono.
const isRoute = /^\/emdash\/reference\/api\/[^/]+\/[^/]+\/$/.test(path);
---

{!splash && (
	<header class="fx-page-title">
		{crumbs.length > 0 && (
			<nav aria-label="Breadcrumb">
				<ol class="crumbs">
					{crumbs.map((c) => <li>{c}</li>)}
				</ol>
			</nav>
		)}
		<div class="title-row">
			<h1 id="_top" class:list={{ route: isRoute }}>{title}</h1>
			{status === "available" && (
				<span class="status">
					<span class="dot" aria-hidden="true" />
					Available · {EMDASH_VERSION}
				</span>
			)}
		</div>
		{lede && <p class="lede">{lede}</p>}
	</header>
)}

<style>
	.fx-page-title {
		display: flex;
		flex-direction: column;
		gap: 14px;
		margin-top: 0.5rem;
		animation: fx-up 0.6s var(--fx-ease) both;
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 14px;
		line-height: 20px;
		color: var(--fx-text-3);
	}

	.crumbs li + li::before {
		content: "/";
		content: "/" / "";
		margin-inline-end: 6px;
	}

	.title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 16px;
	}

	h1 {
		margin: 0;
		font-size: var(--sl-text-h1);
		line-height: 1.18;
		color: var(--fx-text);
	}

	h1.route {
		font-family: var(--fx-font-mono);
		font-size: clamp(30px, 4vw, 40px);
		letter-spacing: -0.02em;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 4px 12px 4px 10px;
		border-radius: var(--fx-radius-pill);
		background: color-mix(in srgb, var(--fx-success) 14%, transparent);
		color: var(--fx-success);
		font-size: 14px;
		line-height: 20px;
		font-weight: 600;
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: currentColor;
		animation: fx-pulse 1.8s ease-out infinite;
	}

	.lede {
		margin: 0;
		font-size: var(--fx-text-lg);
		line-height: 32px;
		color: var(--fx-text-2);
	}

	@media (prefers-reduced-motion: reduce) {
		.fx-page-title,
		.dot {
			animation: none;
		}
	}
</style>
