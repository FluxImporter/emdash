---
// Foot of the mobile menu: the header's GitHub link and theme switch, which the narrow header hides.
import GitHubIcon from "./GitHubIcon.astro";
import { GITHUB_URL } from "../site";
import ThemeSelect from "./ThemeSelect.astro";
---

<div class="fx-mobile-footer">
	<a href={GITHUB_URL}>
		<GitHubIcon />
		GitHub
	</a>
	<ThemeSelect />
</div>

<style>
	.fx-mobile-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 16px;
		padding-top: 16px;
		border-top: 1px solid var(--fx-line);
	}

	a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		color: var(--fx-text);
		text-decoration: none;
		font-weight: 500;
	}
</style>
