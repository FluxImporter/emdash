---
// Docs page footer (GuidePage.dc.html): edit link and last-updated line, previous / next,
// then the site footer. The splash home page renders its own footer in the page body.
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "./Pagination.astro";
import SiteFooter from "./SiteFooter.astro";

const route = Astro.locals.starlightRoute;
const splash = route.entry.data.template === "splash";
const hasMeta = Boolean(route.editUrl || route.lastUpdated);
---

{!splash && (
	<div class="fx-page-footer">
		{hasMeta && <div class="meta"><EditLink /><LastUpdated /></div>}
		<Pagination />
		<SiteFooter variant="docs" />
	</div>
)}

<style>
	.fx-page-footer {
		display: flex;
		flex-direction: column;
		gap: 20px;
		margin-top: 32px;
		padding-top: 24px;
		border-top: 1px solid var(--fx-line);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 24px;
		font-size: 14px;
		line-height: 20px;
		color: var(--fx-text-3);
	}

	.meta :global(a) {
		color: var(--fx-text-2);
		text-decoration: underline;
		text-decoration-color: var(--fx-accent-line);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.meta :global(a:hover) {
		background: #ffd23f;
		color: #0f2233;
	}

	.meta :global(p) {
		margin: 0;
	}
</style>
