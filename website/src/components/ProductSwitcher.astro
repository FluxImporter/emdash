---
// Product switcher above the docs sidebar (Sidebar.dc.html): EmDash (available) and
// WordPress (soon, not a link). A disclosure button with a small menu; Escape and a click
// outside close it.
import { DOCS_URL, EMDASH_VERSION } from "../site";
---

<fx-product-switcher class="fx-switcher">
	<button type="button" class="trigger" aria-expanded="false" aria-controls="fx-product-menu">
		<span class="tile" aria-hidden="true">E</span>
		<span class="names"><span class="kicker">Product</span><span>EmDash</span></span>
		<span class="version">{EMDASH_VERSION}</span>
		<svg class="caret" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>
	</button>
	<ul id="fx-product-menu" class="menu" hidden>
		<li>
			<a href={DOCS_URL} aria-current="true">EmDash<span class="available">Available</span></a>
		</li>
		<li>
			<span class="soon-item" aria-disabled="true">WordPress<span class="soon">soon</span></span>
		</li>
	</ul>
</fx-product-switcher>

<script>
	class FxProductSwitcher extends HTMLElement {
		connectedCallback() {
			const trigger = this.querySelector<HTMLButtonElement>(".trigger");
			const menu = this.querySelector<HTMLUListElement>(".menu");
			if (!trigger || !menu) return;
			const set = (open: boolean) => {
				trigger.setAttribute("aria-expanded", String(open));
				menu.hidden = !open;
			};
			trigger.addEventListener("click", () => set(menu.hidden));
			this.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && !menu.hidden) {
					set(false);
					trigger.focus();
				}
			});
			document.addEventListener("click", (event) => {
				if (!menu.hidden && event.target instanceof Node && !this.contains(event.target)) set(false);
			});
			this.addEventListener("focusout", (event) => {
				if (!(event.relatedTarget instanceof Node) || !this.contains(event.relatedTarget)) set(false);
			});
		}
	}
	customElements.define("fx-product-switcher", FxProductSwitcher);
</script>

<style>
	.fx-switcher {
		position: relative;
		display: block;
		margin-bottom: 20px;
	}

	.trigger {
		width: 100%;
		min-height: 48px;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 0 12px;
		border: 1px solid var(--fx-line-strong);
		border-radius: 10px;
		background: var(--fx-bg-1);
		color: var(--fx-text);
		font: 600 var(--fx-text-sm) / 22px var(--fx-font-body);
		cursor: pointer;
		text-align: start;
	}

	.tile {
		width: 26px;
		height: 26px;
		flex: none;
		border-radius: 7px;
		background: #ffd23f;
		color: #0f2233;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: var(--fx-text-xs);
		font-weight: 700;
	}

	.names {
		display: flex;
		flex-direction: column;
		line-height: 18px;
	}

	.kicker {
		font-size: 12px;
		font-weight: 500;
		color: var(--fx-text-3);
	}

	.version {
		margin-inline-start: auto;
		font-family: var(--fx-font-mono);
		font-size: 12px;
		font-weight: 400;
		color: var(--fx-text-3);
	}

	.caret {
		flex: none;
		transition: transform 0.2s ease;
	}

	[aria-expanded="true"] .caret {
		transform: rotate(180deg);
	}

	.menu {
		position: absolute;
		inset-inline: 0;
		top: 54px;
		z-index: 2;
		margin: 0;
		padding: 6px;
		list-style: none;
		background: var(--fx-bg-1);
		border: 1px solid var(--fx-line-strong);
		border-radius: 12px;
		box-shadow: 0 20px 50px rgb(0 0 0 / 0.45);
		animation: fx-in 0.18s ease both;
	}

	:global([data-theme="light"]) .menu {
		box-shadow: 0 18px 40px rgb(15 34 51 / 0.14);
	}

	.menu a,
	.soon-item {
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		padding: 0 10px;
		border-radius: 8px;
		font-size: var(--fx-text-sm);
	}

	.menu a {
		background: var(--fx-bg-2);
		color: var(--fx-text);
		font-weight: 600;
		text-decoration: none;
	}

	.soon-item {
		color: var(--fx-text-3);
	}

	.available {
		margin-inline-start: auto;
		font-size: 12px;
		font-weight: 600;
		color: var(--fx-success);
	}

	.soon {
		margin-inline-start: auto;
		font-size: 12px;
		font-weight: 600;
		padding: 1px 8px;
		border-radius: var(--fx-radius-pill);
		border: 1px dashed var(--fx-line-strong);
	}

	@keyframes fx-in {
		from {
			opacity: 0;
			transform: translateY(-8px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
