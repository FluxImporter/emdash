---
// Site footer (Footer.dc.html): wordmark, licence line, GitHub and npm links.
// variant "home" centres it at 1200px with more padding; "docs" fills the column.
import GitHubIcon from "./GitHubIcon.astro";
import { GITHUB_URL, NPM_URL, PACKAGE } from "../site";
import Logo from "./Logo.astro";

interface Props {
	variant?: "home" | "docs";
}
const { variant = "docs" } = Astro.props;
---

<footer class:list={["fx-site-footer", variant]}>
	<div class="inner">
		<div class="about">
			<Logo size={24} />
			<span class="meta"><span>MIT licensed</span><span aria-hidden="true">·</span><span>Built for EmDash</span></span>
		</div>
		<nav aria-label="Project links">
			<a href={GITHUB_URL}>
				<GitHubIcon />
				GitHub
			</a>
			<a href={NPM_URL}><span class="npm">npm</span><span class="pkg">{PACKAGE}</span></a>
		</nav>
	</div>
</footer>

<style>
	.fx-site-footer {
		background: var(--fx-bg-1);
		color: var(--fx-text-2);
		border-top: 1px solid var(--fx-line);
		font-size: var(--fx-text-sm);
		line-height: 22px;
	}

	.inner {
		margin: 0 auto;
		padding: 24px;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 20px 40px;
	}

	.home .inner {
		max-width: 1200px;
		padding: 48px 24px;
	}

	.docs {
		border: 1px solid var(--fx-line);
		border-radius: var(--fx-radius-lg);
	}

	.about {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 16px;
		color: var(--fx-text-3);
		font-size: 14px;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 8px;
	}

	nav a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 12px;
		color: var(--fx-text);
		text-decoration: none;
		font-weight: 500;
		border: 1px solid var(--fx-line);
		border-radius: 8px;
		transition: border-color var(--fx-dur) var(--fx-ease);
	}

	nav a:hover {
		border-color: #ffd23f;
	}

	.npm,
	.pkg {
		font-family: var(--fx-font-mono);
		font-size: var(--fx-text-xs);
	}

	.npm {
		font-weight: 600;
	}

	.pkg {
		color: var(--fx-text-3);
	}
</style>
