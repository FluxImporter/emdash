---
// "Where next" link cards (EmDash.dc.html): group, title with a yellow arrow, one line of text.
interface Props {
	links: { group: string; title: string; text: string; href: string }[];
}
const { links } = Astro.props;
---

<ul class="fx-link-cards not-content">
	{links.map((l) => (
		<li>
			<a href={l.href}>
				<span class="group">{l.group}</span>
				<span class="title">
					{l.title}
					<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
				</span>
				<span class="text">{l.text}</span>
			</a>
		</li>
	))}
</ul>

<style>
	ul {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 12px;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	a {
		height: 100%;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 18px 20px;
		border: 1px solid var(--fx-line);
		border-radius: 14px;
		background: var(--fx-bg-1);
		color: var(--fx-text);
		text-decoration: none;
		transition:
			transform var(--fx-dur) var(--fx-ease),
			border-color var(--fx-dur) var(--fx-ease);
	}

	a:hover {
		transform: translateY(-2px);
		border-color: #ffd23f;
	}

	.group {
		font-size: 13px;
		line-height: 18px;
		color: var(--fx-text-3);
	}

	.title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		font-family: var(--fx-font-display);
		font-weight: 600;
		font-size: 18px;
		line-height: 26px;
	}

	svg {
		flex: none;
		color: var(--fx-accent-line);
	}

	.text {
		font-size: var(--fx-text-sm);
		line-height: 22px;
		color: var(--fx-text-2);
	}
</style>
