---
// A dashed stand-in for an admin screenshot that hasn't been taken yet (GuidePage.dc.html).
interface Props {
	/** What the screenshot will show, for screen readers. */
	alt: string;
	/** The visible placeholder label, e.g. "[ADMIN SCREENSHOT: New schedule, 1600 × 900]". */
	label: string;
	caption?: string;
}
const { alt, label, caption } = Astro.props;
---

<figure class="fx-shot not-content">
	<div class="frame" role="img" aria-label={`Screenshot placeholder: ${alt}`}>
		<span class="bar short" />
		<span class="bar field" />
		<span class="bar field" />
		<span class="chips"><span class="chip on" /><span class="chip" /><span class="chip" /><span class="chip" /></span>
		<span class="label">{label}</span>
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	figure {
		margin: 1.25rem 0 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.frame {
		aspect-ratio: 16 / 9;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 24px;
		border: 2px dashed var(--fx-line-strong);
		border-radius: 14px;
		background: var(--fx-bg-1);
	}

	.bar {
		display: block;
		background: var(--fx-bg-2);
	}

	.short {
		width: 38%;
		height: 14px;
		border-radius: 6px;
	}

	.field {
		width: 70%;
		height: 40px;
		border-radius: 8px;
	}

	.chips {
		display: flex;
		gap: 8px;
	}

	.chip {
		width: 70px;
		height: 32px;
		border-radius: var(--fx-radius-pill);
		background: var(--fx-bg-2);
	}

	.chip.on {
		width: 80px;
		background: #ffd23f;
	}

	.label {
		margin-top: auto;
		align-self: center;
		text-align: center;
		font-family: var(--fx-font-mono);
		font-size: 13px;
		color: var(--fx-text-3);
	}

	figcaption {
		font-size: 14px;
		line-height: 20px;
		color: var(--fx-text-3);
	}

	@media (max-width: 480px) {
		.frame {
			padding: 14px;
			gap: 8px;
		}

		.field {
			height: 24px;
		}

		.chip {
			height: 20px;
		}
	}
</style>
