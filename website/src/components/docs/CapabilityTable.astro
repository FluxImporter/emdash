---
// Permissions table with a filter (Permissions.dc.html). The first three rows are real; rows 4 to
// 10 are the mockup's placeholders and stay placeholders until the copy is written.
interface Row {
	cap: string;
	why: string;
	used: { label: string; href?: string }[];
	placeholder?: boolean;
}

const real: Row[] = [
	{
		cap: "content:write",
		why: "Creates and updates entries.",
		used: [
			{ label: "Imports", href: "/emdash/guides/wizard/" },
			{ label: "Rollback", href: "/emdash/guides/rollback/" },
		],
	},
	{
		cap: "media:write",
		why: "Downloads images named in a feed.",
		used: [{ label: "Media fields", href: "/emdash/guides/media/" }],
	},
	{
		cap: "network:request:unrestricted",
		why: "Fetches URL feeds and calls the AI provider you choose.",
		used: [
			{ label: "URL sources", href: "/emdash/guides/url-sources/" },
			{ label: "AI mapping", href: "/emdash/guides/ai-mapping/" },
		],
	},
];
const placeholders: Row[] = Array.from({ length: 7 }, (_, i) => ({
	cap: `[capability ${i + 4}]`,
	why: "[Why Flux Importer needs it]",
	used: [{ label: "[Feature]" }],
	placeholder: true,
}));
const rows = [...real, ...placeholders];
const countText = (n: number) => `${n} of ${rows.length} capabilities`;
---

<fx-capability-table class="not-content fx-wide" data-total={rows.length}>
	<div class="tools" hidden>
		<label class="filter">
			<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 6h16M7 12h10M10 18h4" /></svg>
			<span class="sr-only">Filter capabilities</span>
			<input type="search" placeholder="Filter by capability or feature" autocomplete="off" />
		</label>
		<span class="count" role="status">{countText(rows.length)}</span>
	</div>
	<div class="scroller" role="region" aria-label="Capabilities" tabindex="0">
		<table>
			<thead>
				<tr>
					<th scope="col" class="c-cap">Capability</th>
					<th scope="col">Why Flux Importer needs it</th>
					<th scope="col" class="c-used">Used by</th>
				</tr>
			</thead>
			<tbody>
				{rows.map((r, i) => (
					<tr
						class:list={{ placeholder: r.placeholder }}
						style={`animation-delay: ${(0.04 * i).toFixed(2)}s`}
						data-search={`${r.cap} ${r.why} ${r.used.map((u) => u.label).join(" ")}`.toLowerCase()}
					>
						<td><code>{r.cap}</code></td>
						<td class="why">{r.why}</td>
						<td>
							<span class="pills">
								{r.used.map((u) => (u.href ? <a href={u.href}>{u.label}</a> : <span>{u.label}</span>))}
							</span>
						</td>
					</tr>
				))}
				<tr class="empty" hidden>
					<td colspan="3">No capabilities match.</td>
				</tr>
			</tbody>
		</table>
	</div>
	<p class="note">Rows 4 to 10 are placeholders to show the table at full length.</p>
</fx-capability-table>

<script>
	class FxCapabilityTable extends HTMLElement {
		connectedCallback() {
			const tools = this.querySelector<HTMLElement>(".tools");
			const input = this.querySelector<HTMLInputElement>("input");
			const count = this.querySelector<HTMLElement>(".count");
			const empty = this.querySelector<HTMLElement>("tr.empty");
			const rows = [...this.querySelectorAll<HTMLElement>("tr[data-search]")];
			const total = rows.length;
			if (!tools || !input || !count || !empty) return;
			tools.hidden = false;
			input.addEventListener("input", () => {
				const q = input.value.trim().toLowerCase();
				let shown = 0;
				for (const row of rows) {
					const match = !q || (row.dataset.search ?? "").includes(q);
					row.hidden = !match;
					if (match) shown++;
				}
				empty.hidden = shown > 0;
				count.textContent = `${shown} of ${total} capabilities`;
			});
		}
	}
	customElements.define("fx-capability-table", FxCapabilityTable);
</script>

<style>
	fx-capability-table {
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin-top: 28px;
	}

	.tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 12px 24px;
	}

	.tools[hidden] {
		display: none;
	}

	.filter {
		flex: 0 1 360px;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		padding: 0 12px;
		border: 1px solid var(--fx-line-strong);
		border-radius: 10px;
		background: var(--fx-bg-1);
		color: var(--fx-text-3);
	}

	.filter:focus-within {
		outline: 2px solid var(--fx-accent-line);
		outline-offset: 2px;
	}

	input {
		flex: 1 1 auto;
		min-width: 0;
		border: 0;
		outline: none;
		background: transparent;
		color: var(--fx-text);
		font: 15px/22px var(--fx-font-body);
	}

	input::placeholder {
		color: var(--fx-text-3);
		opacity: 1;
	}

	.count,
	.note {
		margin: 0;
		font-size: 14px;
		line-height: 20px;
		color: var(--fx-text-3);
	}

	.scroller {
		overflow-x: auto;
		border: 1px solid var(--fx-line);
		border-radius: 14px;
	}

	table {
		width: 100%;
		min-width: 720px;
		border-collapse: collapse;
		font-size: var(--fx-text-sm);
		line-height: 22px;
	}

	th {
		padding: 14px 18px;
		background: var(--fx-bg-1);
		text-align: start;
		font-weight: 600;
		color: var(--fx-text);
	}

	.c-cap {
		width: 32%;
	}

	.c-used {
		width: 26%;
	}

	td {
		padding: 14px 18px;
		border-top: 1px solid var(--fx-line);
		vertical-align: top;
		color: var(--fx-text-2);
	}

	tbody tr {
		animation: fx-up 0.45s ease both;
	}

	tr[hidden] {
		display: none;
	}

	code {
		padding: 3px 8px;
		border: 1px solid var(--fx-line);
		border-radius: 6px;
		background: var(--fx-bg-2);
		color: #ffd23f;
		font-family: var(--fx-font-mono);
		font-size: 13px;
		font-weight: 600;
		white-space: nowrap;
	}

	:global(:root[data-theme="light"]) code {
		background: #0f2233;
	}

	.placeholder td,
	.placeholder .why {
		color: var(--fx-text-3);
	}

	.placeholder code,
	:global(:root[data-theme="light"]) .placeholder code {
		background: transparent;
		border-color: var(--fx-line-strong);
		color: var(--fx-text-3);
	}

	.pills {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.pills > * {
		padding: 2px 10px;
		border: 1px solid var(--fx-line-strong);
		border-radius: var(--fx-radius-pill);
		font-size: 13px;
		line-height: 20px;
		color: inherit;
		text-decoration: none;
	}

	.pills a {
		color: var(--fx-text-2);
		transition: border-color var(--fx-dur) var(--fx-ease);
	}

	.pills a:hover {
		border-color: #ffd23f;
		color: var(--fx-text);
	}

	.empty td {
		color: var(--fx-text-3);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	@media (prefers-reduced-motion: reduce) {
		tbody tr {
			animation: none;
		}
	}
</style>
