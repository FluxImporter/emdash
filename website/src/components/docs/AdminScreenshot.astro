---
// A screenshot of the Flux Importer admin, in the reader's theme: the light capture under the
// light theme, the dark one otherwise. Imported PNGs are copied as hashed assets (no Sharp in
// this site); the hidden one is display: none and lazy, so the browser fetches only what it shows.
import type { ImageMetadata } from "astro";

interface Props {
	/** What the screenshot shows, for screen readers. */
	alt: string;
	light: ImageMetadata;
	dark: ImageMetadata;
	caption?: string;
}
const { alt, light, dark, caption } = Astro.props;
---

<figure class="fx-admin-shot not-content">
	<div class="frame">
		<img class="light" src={light.src} width={light.width} height={light.height} alt={alt} loading="lazy" decoding="async" />
		<img class="dark" src={dark.src} width={dark.width} height={dark.height} alt={alt} loading="lazy" decoding="async" />
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	figure {
		margin: 1.25rem 0 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.frame {
		overflow: hidden;
		border: 1px solid var(--fx-line-strong);
		border-radius: 14px;
		background: var(--fx-bg-1);
	}

	img {
		display: block;
		width: 100%;
		height: auto;
	}

	.light {
		display: none;
	}

	:global(:root[data-theme="light"]) .light {
		display: block;
	}

	:global(:root[data-theme="light"]) .dark {
		display: none;
	}

	figcaption {
		font-size: 14px;
		line-height: 20px;
		color: var(--fx-text-3);
	}
</style>
