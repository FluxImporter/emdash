---
// The mark and the "fluximporter" wordmark (Header.dc.html, Footer.dc.html).
interface Props {
	size?: number;
	animated?: boolean;
}
const { size = 28, animated = false } = Astro.props;
---

<span class="fx-logo">
	<svg class:list={["mark", { animated }]} aria-hidden="true" width={size} height={size} viewBox="0 0 24 24">
		<rect width="24" height="24" rx="6" fill="#ffd23f"></rect>
		<rect class="bar" x="4" y="6.2" width="6" height="2.6" rx="1.3" fill="#0f2233"></rect>
		<rect class="bar" x="4" y="10.7" width="8.5" height="2.6" rx="1.3" fill="#0f2233"></rect>
		<rect class="bar" x="4" y="15.2" width="6" height="2.6" rx="1.3" fill="#0f2233"></rect>
		<rect x="13.8" y="5.2" width="6.2" height="13.6" rx="1.6" fill="#0f2233"></rect>
	</svg>
	<span class="word" style={`font-size: ${size === 28 ? 20 : 18}px`}><b>flux</b><span>importer</span></span>
</span>

<style>
	.fx-logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: var(--fx-text);
	}

	.mark {
		flex: none;
	}

	.word {
		font-family: var(--fx-font-display);
		line-height: 28px;
		letter-spacing: -0.02em;
		white-space: nowrap;
	}

	.word b {
		font-weight: 700;
	}

	.word span {
		font-weight: 500;
		color: var(--fx-text-2);
	}

	.animated .bar {
		transform-box: fill-box;
		animation: fx-flow 2.4s ease-in-out infinite;
	}

	.animated .bar:nth-of-type(3) {
		animation-delay: 0.2s;
	}

	.animated .bar:nth-of-type(4) {
		animation-delay: 0.4s;
	}

	@keyframes fx-flow {
		0%,
		100% {
			transform: translateX(-1.5px);
		}
		50% {
			transform: translateX(1.5px);
		}
	}
</style>
