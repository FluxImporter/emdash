---
// Two-button colour switch (Header.dc.html). Replaces Starlight's Auto/Dark/Light select:
// with no stored choice the site is dark (design default), so there is no "Auto" state.
---

<fx-theme-switch>
	<div class="fx-theme-switch" role="group" aria-label="Colour theme">
		<button type="button" data-theme-value="dark" aria-label="Dark theme" aria-pressed="true">
			<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
		</button>
		<button type="button" data-theme-value="light" aria-label="Light theme" aria-pressed="false">
			<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
		</button>
	</div>
</fx-theme-switch>

<script>
	type Theme = "dark" | "light";
	const storageKey = "starlight-theme";

	function current(): Theme {
		return document.documentElement.dataset.theme === "light" ? "light" : "dark";
	}

	function sync(theme: Theme): void {
		for (const button of document.querySelectorAll<HTMLButtonElement>("fx-theme-switch button")) {
			button.setAttribute("aria-pressed", String(button.dataset.themeValue === theme));
		}
	}

	function apply(theme: Theme): void {
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem(storageKey, theme);
		} catch {
			// Storage blocked: the choice lasts for this page only.
		}
		sync(theme);
	}

	class FxThemeSwitch extends HTMLElement {
		connectedCallback() {
			sync(current());
			for (const button of this.querySelectorAll<HTMLButtonElement>("button")) {
				button.addEventListener("click", () => apply(button.dataset.themeValue === "light" ? "light" : "dark"));
			}
		}
	}
	customElements.define("fx-theme-switch", FxThemeSwitch);
</script>

<style>
	.fx-theme-switch {
		display: flex;
		padding: 3px;
		border: 1px solid var(--fx-line);
		border-radius: 10px;
		background: var(--fx-bg-1);
	}

	button {
		width: 40px;
		height: 38px;
		border: 0;
		border-radius: 7px;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		color: var(--fx-text-2);
		transition:
			background-color var(--fx-dur) var(--fx-ease),
			color var(--fx-dur) var(--fx-ease);
	}

	button:hover {
		color: var(--fx-text);
	}

	button[aria-pressed="true"] {
		background: #ffd23f;
		color: #0f2233;
	}
</style>
