---
// Previous / next cards (PrevNext.dc.html).
const { pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

{(prev || next) && (
	<nav class="fx-prevnext print:hidden" aria-label="Previous and next pages">
		{prev ? (
			<a class="card" href={prev.href} rel="prev">
				<svg class="arrow" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
				<span class="text"><span class="kicker">Previous</span><span class="title">{prev.label}</span></span>
			</a>
		) : <span class="spacer" />}
		{next && (
			<a class="card next" href={next.href} rel="next">
				<span class="text"><span class="kicker">Next</span><span class="title">{next.label}</span></span>
				<svg class="arrow" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffd23f" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
			</a>
		)}
	</nav>
)}

<style>
	.fx-prevnext {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}

	.card,
	.spacer {
		flex: 1 1 260px;
		min-width: 0;
	}

	.card {
		min-height: 88px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 16px 20px;
		border: 1px solid var(--fx-line);
		border-radius: 14px;
		background: var(--fx-bg-1);
		color: var(--fx-text);
		text-decoration: none;
		transition:
			transform var(--fx-dur) ease,
			border-color var(--fx-dur) ease;
	}

	:global([data-theme="light"]) .card {
		background: #ffffff;
	}

	.card:hover {
		transform: translateY(-3px);
		border-color: #ffd23f;
	}

	.next {
		justify-content: flex-end;
		text-align: end;
	}

	.arrow {
		flex: none;
		color: var(--fx-text-3);
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.kicker {
		font-size: var(--fx-text-xs);
		line-height: 18px;
		color: var(--fx-text-3);
	}

	.title {
		font-family: var(--fx-font-display);
		font-weight: 600;
		font-size: 18px;
		line-height: 26px;
		overflow-wrap: anywhere;
	}
</style>
