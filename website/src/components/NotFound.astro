---
// 404 page body (NotFound.dc.html): feed bars that miss their target, the message, a search
// button that opens the header search, and links back to the docs and home.
import { DOCS_URL } from "../site";
---

<div class="fx-404 fx-splash not-content">
	<div class="inner">
		<svg class="art" aria-hidden="true" width="200" height="120" viewBox="0 0 200 120" fill="none">
			<rect class="feed" x="10" y="30" width="56" height="12" rx="6" />
			<rect class="feed f2" x="10" y="54" width="76" height="12" rx="6" />
			<rect class="feed f3" x="10" y="78" width="56" height="12" rx="6" />
			<rect class="target" x="120" y="18" width="62" height="84" rx="12" stroke-width="3" stroke-dasharray="8 8" />
			<text x="151" y="68" text-anchor="middle">?</text>
		</svg>
		<span class="code up">404 · NOT_FOUND</span>
		<h1 id="_top" class="up u2">Nothing imported here.</h1>
		<p class="up u3">This page doesn't exist, or it moved. Search the docs instead.</p>
		<fx-404-search class="up u4">
			<button type="button" disabled>
				<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M11 4a7 7 0 1 0 0 14a7 7 0 1 0 0-14zM20 20l-4-4" /></svg>
				Search guides and reference
				<kbd aria-hidden="true">Ctrl K</kbd>
			</button>
		</fx-404-search>
		<div class="links up u5">
			<a href={DOCS_URL}>EmDash docs</a>
			<a href="/">Home</a>
		</div>
	</div>
</div>

<script>
	// Opens Starlight's search dialog through the header's own search button, and shows the
	// same shortcut it shows (⌘K on a Mac, Ctrl K elsewhere).
	class Fx404Search extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector("button");
			const opener = document.querySelector<HTMLButtonElement>("site-search button[data-open-modal]");
			if (!button || !opener) return;
			const keys = [...opener.querySelectorAll("kbd kbd")].map((k) => k.textContent?.trim()).filter(Boolean);
			const shortcut = keys.join(keys.some((k) => k === "⌘") ? "" : " ");
			const kbd = button.querySelector("kbd");
			if (shortcut && kbd) kbd.textContent = shortcut;
			button.disabled = false;
			// Stop this click reaching the dialog's "click outside closes it" listener on window.
			button.addEventListener("click", (event) => {
				event.stopPropagation();
				opener.click();
			});
		}
	}
	customElements.define("fx-404-search", Fx404Search);
</script>

<style>
	.fx-404 {
		min-height: calc(100vh - var(--sl-nav-height));
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 40px 24px;
		background-image: radial-gradient(color-mix(in srgb, var(--fx-text-2) 10%, transparent) 1.2px, transparent 1.3px);
		background-size: 24px 24px;
	}

	.inner {
		max-width: 560px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 22px;
		text-align: center;
	}

	.art {
		max-width: 100%;
		height: auto;
	}

	.feed {
		fill: #ffd23f;
		animation: fx-feed 2.4s ease-in-out infinite;
	}

	.f2 {
		animation-delay: 0.25s;
	}

	.f3 {
		animation-delay: 0.5s;
	}

	.target {
		stroke: var(--fx-line-strong);
		animation: fx-march 1s linear infinite;
	}

	text {
		fill: var(--fx-text-3);
		font-family: var(--fx-font-mono);
		font-size: 18px;
		font-weight: 600;
	}

	.code {
		font-family: var(--fx-font-mono);
		font-size: 14px;
		line-height: 20px;
		color: var(--fx-text-3);
	}

	h1 {
		margin: 0;
		font-size: clamp(36px, 7vw, 48px);
		line-height: 1.17;
	}

	p {
		margin: 0;
		color: var(--fx-text-2);
	}

	fx-404-search {
		display: block;
		width: 100%;
		max-width: 440px;
	}

	button {
		width: 100%;
		min-height: 52px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 0 10px 0 16px;
		border: 1px solid var(--fx-line-strong);
		border-radius: 12px;
		background: var(--fx-bg-1);
		color: var(--fx-text-3);
		font: inherit;
		text-align: start;
		cursor: pointer;
		transition: border-color var(--fx-dur) var(--fx-ease);
	}

	button:hover:not(:disabled) {
		border-color: #ffd23f;
	}

	button:disabled {
		cursor: default;
	}

	button svg {
		flex: none;
		color: var(--fx-accent-line);
	}

	kbd {
		margin-inline-start: auto;
		padding: 1px 7px;
		border: 1px solid var(--fx-line-strong);
		border-bottom-width: 2px;
		border-radius: 6px;
		font-family: var(--fx-font-mono);
		font-size: 12px;
		line-height: 20px;
		color: var(--fx-text-2);
		white-space: nowrap;
	}

	.links {
		display: flex;
		gap: 20px;
		font-weight: 600;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		color: var(--fx-text);
		text-decoration: underline;
		text-decoration-color: var(--fx-accent-line);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.links a:hover {
		color: var(--fx-accent-ink);
		background: var(--fx-accent);
	}

	.up {
		animation: fx-up 0.5s ease both;
	}

	.u2 {
		animation-delay: 0.06s;
	}

	.u3 {
		animation-delay: 0.12s;
	}

	.u4 {
		animation-delay: 0.18s;
	}

	.u5 {
		animation-delay: 0.24s;
	}

	@keyframes fx-feed {
		0% {
			transform: translateX(-40px);
			opacity: 0;
		}
		30% {
			opacity: 1;
		}
		70% {
			transform: translateX(0);
			opacity: 1;
		}
		100% {
			transform: translateX(6px);
			opacity: 0;
		}
	}

	@keyframes fx-march {
		to {
			stroke-dashoffset: -16;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.feed,
		.target,
		.up {
			animation: none;
		}
	}
</style>
