---
// Request examples in curl / fetch tabs, beside the response (ApiPage.dc.html). The tab choice is
// shared across pages through Starlight's syncKey.
import { Code, TabItem, Tabs } from "@astrojs/starlight/components";
import type { ApiRouteData } from "../../data/api";

interface Props {
	route: ApiRouteData;
}
const { route } = Astro.props;
---

<div class="fx-api-examples">
	<div class="col request">
		<p class="label not-content">Request</p>
		<Tabs syncKey="api-request">
			{route.request.map((r) => (
				<TabItem label={r.label}>
					<Code code={r.code} lang={r.lang} />
				</TabItem>
			))}
		</Tabs>
	</div>
	<div class="col response">
		<p class="label not-content">
			Response <span class="status">{route.response.status}</span>
		</p>
		<Code code={route.response.code} lang={route.response.lang} title={route.response.label} />
	</div>
</div>

<style>
	.fx-api-examples {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: flex-start;
		margin-top: 8px;
	}

	.col {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.request {
		flex: 1 1 400px;
	}

	.response {
		flex: 1 1 300px;
	}

	.col > :global(*) {
		margin-top: 0;
	}

	.label {
		margin: 0;
		font-size: 13px;
		line-height: 18px;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--fx-text-3);
	}

	.status {
		margin-inline-start: 6px;
		padding: 1px 8px;
		border-radius: var(--fx-radius-pill);
		background: color-mix(in srgb, var(--fx-success) 14%, transparent);
		color: var(--fx-success);
		letter-spacing: 0;
	}

	/* Tabs (Starlight): mono labels with a yellow underline, as in the code frame tabs. */
	.request :global(starlight-tabs .tablist-wrapper) {
		border-bottom: 0;
	}

	.request :global(starlight-tabs [role="tablist"]) {
		gap: 4px;
		border-bottom: 1px solid var(--fx-line);
	}

	.request :global(starlight-tabs [role="tab"]) {
		min-height: 40px;
		padding: 0 12px;
		border-bottom: 2px solid transparent;
		font-family: var(--fx-font-mono);
		font-size: 13px;
		color: var(--fx-text-2);
		text-decoration: none;
	}

	.request :global(starlight-tabs [role="tab"][aria-selected="true"]) {
		border-color: #ffd23f;
		color: var(--fx-text);
		font-weight: 600;
	}

	.request :global(starlight-tabs [role="tabpanel"]) {
		margin-top: 8px;
	}
</style>
