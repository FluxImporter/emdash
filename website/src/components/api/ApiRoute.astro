---
// Top of an API route page (ApiPage.dc.html): method and path with a copy button, who can call
// it, and a link to the agent tool section when the route is also an MCP tool. The page title and
// lede come from PageTitle; the sections below are ApiFields, ApiExamples, ApiErrors, ApiAgentTool.
import { API_BASE, type ApiRouteData } from "../../data/api";

interface Props {
	route: ApiRouteData;
}
const { route } = Astro.props;
const fullPath = `${API_BASE}${route.route}`;
---

<div class="fx-api-route not-content">
	<fx-copy-path class="path" data-path={fullPath}>
		<span class="method">{route.method}</span>
		<code><span class="base">{API_BASE}</span><span class="name">{route.route}</span></code>
		<button type="button" aria-label="Copy path" hidden>
			<svg class="icon-copy" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 9h10v11H9zM5 15V4h10" /></svg>
			<svg class="icon-done" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
		</button>
		<span class="sr-only" role="status"></span>
	</fx-copy-path>
	<div class="chips">
		<span class="chip">
			<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z" /></svg>
			<span>
				<strong>{route.role}</strong>{route.csrf && <>; requires header <code>X-EmDash-Request: 1</code></>}
			</span>
		</span>
		{route.agentTool && (
			<a class="chip agent" href="#also-available-as-agent-tool">
				<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 8l-5 4 5 4M16 8l5 4-5 4" /></svg>
				Also available as agent tool <code>{route.agentTool}</code>
			</a>
		)}
	</div>
</div>

<script>
	class FxCopyPath extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector("button");
			const status = this.querySelector<HTMLElement>("[role=status]");
			const path = this.dataset.path;
			if (!button || !status || !path || !navigator.clipboard) return;
			button.hidden = false;
			let timer: ReturnType<typeof setTimeout> | undefined;
			button.addEventListener("click", async () => {
				try {
					await navigator.clipboard.writeText(path);
				} catch {
					return;
				}
				this.classList.add("copied");
				button.setAttribute("aria-label", "Copied");
				status.textContent = "Path copied";
				clearTimeout(timer);
				timer = setTimeout(() => {
					this.classList.remove("copied");
					button.setAttribute("aria-label", "Copy path");
					status.textContent = "";
				}, 1600);
			});
		}
	}
	customElements.define("fx-copy-path", FxCopyPath);
</script>

<style>
	.fx-api-route {
		display: flex;
		flex-direction: column;
		gap: 16px;
		margin-top: 8px;
	}

	.path {
		display: flex;
		align-items: stretch;
		min-width: 0;
		overflow: hidden;
		border: 1px solid var(--fx-line-strong);
		border-radius: 10px;
		background: var(--fx-bg-1);
	}

	.method {
		flex: none;
		display: flex;
		align-items: center;
		padding: 0 12px;
		background: #ffd23f;
		color: #0f2233;
		font-family: var(--fx-font-mono);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.path code {
		flex: 1 1 auto;
		min-width: 0;
		padding: 10px 12px;
		font-family: var(--fx-font-mono);
		font-size: 14px;
		line-height: 22px;
		overflow-wrap: anywhere;
		color: var(--fx-text);
	}

	.base {
		color: var(--fx-text-3);
	}

	.name {
		font-weight: 600;
	}

	.path button {
		flex: none;
		width: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 0;
		border-inline-start: 1px solid var(--fx-line);
		background: transparent;
		color: var(--fx-text);
		cursor: pointer;
		transition: background-color var(--fx-dur) var(--fx-ease);
	}

	.path button[hidden] {
		display: none;
	}

	.path button:hover {
		background: var(--fx-bg-2);
	}

	.icon-done,
	.copied .icon-copy {
		display: none;
	}

	.copied .icon-done {
		display: block;
	}

	.copied button,
	.copied button:hover {
		background: #5fd39a;
		color: #0f2233;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.chip {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 8px 14px;
		border: 1px solid var(--fx-line);
		border-radius: 10px;
		background: var(--fx-bg-1);
		color: var(--fx-text);
		font-size: var(--fx-text-sm);
		line-height: 22px;
	}

	.chip svg {
		flex: none;
		color: var(--fx-text-2);
	}

	.chip strong {
		font-weight: 600;
	}

	.chip code {
		padding: 1px 6px;
		border-radius: 5px;
		background: var(--fx-bg-2);
		font-family: var(--fx-font-mono);
		font-size: 14px;
	}

	.agent {
		gap: 8px;
		border-style: dashed;
		border-color: var(--fx-line-strong);
		background: transparent;
		color: var(--fx-text-2);
		text-decoration: none;
		transition: border-color var(--fx-dur) var(--fx-ease);
	}

	.agent:hover {
		border-color: #ffd23f;
	}

	.agent code {
		padding: 0;
		background: none;
		color: var(--fx-text);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
</style>
