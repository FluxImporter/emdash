---
// Replaces Starlight's ThemeProvider: with no stored choice the site opens dark instead of
// following the system (design default). Runs inline in <head> to avoid a flash of the
// wrong theme. The switch itself is ThemeSelect.astro.
---

<script is:inline>
	(() => {
		let stored = null;
		try {
			stored = localStorage.getItem("starlight-theme");
		} catch {
			// Storage blocked: dark.
		}
		document.documentElement.dataset.theme = stored === "light" ? "light" : "dark";
	})();
	// Starlight's own scripts call this; the switch syncs its buttons itself.
	window.StarlightThemeProvider = { updatePickers() {} };
</script>
