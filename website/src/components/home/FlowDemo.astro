---
// Animated import demo: Map → Dry run → Import → Roll back (FlowDemo.dc.html).
// The server renders the finished import, which is also what reduced-motion visitors and
// visitors without JavaScript see. With motion allowed, the script plays the four steps once
// the demo scrolls into view; Pause and Replay control it, and each step can be opened directly.
// All figures are example data.
const rows = [
	{ src: "sku", dst: "slug", type: "string", ai: true },
	{ src: "name", dst: "title", type: "string", ai: false },
	{ src: "price_gbp", dst: "price", type: "number", ai: true },
	{ src: "image_url", dst: "featured_image", type: "media", ai: true },
	{ src: "category", dst: "category", type: "taxonomy", ai: false },
];
const steps = ["Map", "Dry run", "Import", "Roll back"];
const runLog = ["batch 1 of 3 · 50 records", "batch 2 of 3 · 50 records", "batch 3 of 3 · 28 records"];
const check = "M5 12.5l4.5 4.5L19 7.5";
---

<figure class="fx-flow">
	<fx-flow-demo class="frame">
		<div class="bar">
			<span class="file">products.csv <span class="arrow">→</span> Products</span>
			<ol class="steps" aria-label="Import steps">
				{steps.map((label, i) => (
					<li>
						<button type="button" data-step={i} class:list={["step", { cur: i === 2, past: i < 2 }]} aria-current={i === 2 ? "step" : undefined}>
							<span class="dot">{i < 2 ? "✓" : String(i + 1)}</span>
							{label}
						</button>
					</li>
				))}
			</ol>
			<div class="controls">
				<button type="button" class="ctl pause" hidden>Pause</button>
				<button type="button" class="ctl replay">Replay</button>
			</div>
		</div>

		<div class="body">
			<div class="map">
				<div class="map-head" aria-hidden="true"><span>Source column</span><span></span><span>EmDash field</span></div>
				<ul class="rows">
					{rows.map((r) => (
						<li class="row on" data-ai={r.ai ? "" : undefined}>
							<span class="src">{r.src}</span>
							<span class="wire" aria-hidden="true"><span class="fill"></span></span>
							<span class="dst">
								<span class="dst-name">{r.dst}</span>
								<span class="dst-type">{r.type}</span>
								{r.ai && <span class="ai">AI</span>}
							</span>
						</li>
					))}
				</ul>
			</div>

			<div class="side">
				<div class="panel panel-map" hidden>
					<span class="panel-title">Mapping <span class="mapped">5</span> of 5 columns</span>
					<p>AI suggested <span class="ai-count">3</span> matches. You confirm each one before the dry run.</p>
					<div class="sample">row 1 · TEE-014 · "Logo tee" · 24.00</div>
				</div>

				<div class="panel panel-dry" hidden>
					<span class="panel-title">Dry run: nothing written</span>
					{[
						["Create", 96, "ok"],
						["Update", 31, "flow"],
						["Skip", 1, "muted"],
					].map(([label, n, tone]) => (
						<div class="stat" data-total={n}>
							<div class="stat-line"><span>{label}</span><span class="stat-n">{n}</span></div>
							<span class="meter"><span class:list={["meter-fill", tone]} style={`width: ${(Number(n) / 128) * 100}%`}></span></span>
						</div>
					))}
				</div>

				<div class="panel panel-run">
					<div class="run-head"><span class="panel-title run-title">Import complete</span><span class="pct">100%</span></div>
					<span class="meter big"><span class="meter-fill run-fill" style="width: 100%"></span></span>
					<ul class="log">
						{runLog.map((line) => (
							<li>
								<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d={check}></path></svg>
								<span>{line}</span>
							</li>
						))}
					</ul>
					<button type="button" class="ctl rollback">Roll back run #12</button>
				</div>
			</div>
		</div>
	</fx-flow-demo>
	<figcaption>Example data. Every step runs in the EmDash admin, through the API, or from an AI agent.</figcaption>
</figure>

<script>
	const DUR = [58, 40, 54, 44];
	const CHECK = "M5 12.5l4.5 4.5L19 7.5";
	const RUN_LOG: Array<[number, string]> = [
		[1 / 3, "batch 1 of 3 · 50 records"],
		[2 / 3, "batch 2 of 3 · 50 records"],
		[1, "batch 3 of 3 · 28 records"],
	];
	const ROLLBACK_LOG: Array<[number, string]> = [
		[0.5, "96 created entries removed"],
		[1, "31 updated entries restored"],
	];
	const reduceMotion = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

	class FxFlowDemo extends HTMLElement {
		#ph = 2;
		#t = DUR[2]!;
		#paused = false;
		#done = true;
		#timer: ReturnType<typeof setInterval> | undefined;

		connectedCallback() {
			for (const button of this.querySelectorAll<HTMLButtonElement>(".step")) {
				button.addEventListener("click", () => this.#go(Number(button.dataset.step)));
			}
			this.querySelector(".replay")?.addEventListener("click", () => this.#go(0));
			this.querySelector(".rollback")?.addEventListener("click", () => this.#go(3));
			this.querySelector(".pause")?.addEventListener("click", () => {
				this.#paused = !this.#paused;
				this.#render();
			});
			if (reduceMotion()) return;
			const io = new IntersectionObserver((entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					io.disconnect();
					this.#go(0);
				}
			});
			io.observe(this);
		}

		disconnectedCallback() {
			clearInterval(this.#timer);
		}

		#go(ph: number) {
			const still = reduceMotion();
			this.#ph = ph;
			this.#t = still ? DUR[ph]! : 0;
			this.#done = still;
			this.#paused = false;
			clearInterval(this.#timer);
			if (!still) this.#timer = setInterval(() => this.#tick(), 80);
			this.#render();
		}

		#tick() {
			if (this.#paused || this.#done) return;
			if (this.#t < DUR[this.#ph]!) this.#t++;
			else if (this.#ph < 3) {
				this.#ph++;
				this.#t = 0;
			} else {
				this.#done = true;
				clearInterval(this.#timer);
			}
			this.#render();
		}

		#render() {
			const ph = this.#ph;
			const p = Math.max(0, Math.min(1, this.#t / (DUR[ph]! - 12)));
			const mapped = (i: number) => ph > 0 || this.#t >= 6 + i * 9;
			const running = ph === 2 && p < 1 && !this.#done;

			this.querySelectorAll<HTMLButtonElement>(".step").forEach((button, i) => {
				button.classList.toggle("cur", i === ph);
				button.classList.toggle("past", i < ph);
				if (i === ph) button.setAttribute("aria-current", "step");
				else button.removeAttribute("aria-current");
				const dot = button.querySelector(".dot");
				if (dot) dot.textContent = i < ph ? "✓" : String(i + 1);
			});

			let mappedCount = 0;
			let aiCount = 0;
			this.querySelectorAll<HTMLElement>(".row").forEach((row, i) => {
				const on = mapped(i);
				if (on) mappedCount++;
				if (on && row.hasAttribute("data-ai")) aiCount++;
				row.classList.toggle("on", on);
				row.classList.toggle("running", running);
			});

			const show = (cls: string, visible: boolean) => {
				const el = this.querySelector<HTMLElement>(cls);
				if (el) el.hidden = !visible;
			};
			show(".panel-map", ph === 0);
			show(".panel-dry", ph === 1);
			show(".panel-run", ph >= 2);
			show(".pause", !this.#done);

			const set = (cls: string, text: string) => {
				const el = this.querySelector(cls);
				if (el) el.textContent = text;
			};
			set(".mapped", String(mappedCount));
			set(".ai-count", String(aiCount));
			set(".pause", this.#paused ? "Play" : "Pause");

			this.querySelectorAll<HTMLElement>(".stat").forEach((stat) => {
				const total = Number(stat.dataset.total);
				const n = total === 1 ? (p >= 1 ? 1 : 0) : Math.round(total * p);
				const num = stat.querySelector(".stat-n");
				const fill = stat.querySelector<HTMLElement>(".meter-fill");
				if (num) num.textContent = String(n);
				if (fill) fill.style.width = `${(n / 128) * 100}%`;
			});

			const pct = Math.round(p * 100);
			const rollingBack = ph === 3;
			set(".run-title", rollingBack ? (p >= 1 ? "Run #12 rolled back" : "Rolling back run #12") : p >= 1 ? "Import complete" : "Importing 128 records");
			set(".pct", `${pct}%`);
			this.classList.toggle("rolling-back", rollingBack);
			const runFill = this.querySelector<HTMLElement>(".run-fill");
			if (runFill) runFill.style.width = `${pct}%`;

			const log = this.querySelector<HTMLElement>(".log");
			if (log) {
				const lines = (rollingBack ? ROLLBACK_LOG : RUN_LOG).filter(([at]) => p >= at);
				if (log.childElementCount !== lines.length || log.dataset.mode !== String(rollingBack)) {
					log.dataset.mode = String(rollingBack);
					log.replaceChildren(
						...lines.map(([, text]) => {
							const li = document.createElement("li");
							li.innerHTML = `<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="${CHECK}"></path></svg>`;
							const span = document.createElement("span");
							span.textContent = text;
							li.append(span);
							return li;
						}),
					);
				}
			}
			show(".rollback", ph === 2 && p >= 1);
		}
	}
	customElements.define("fx-flow-demo", FxFlowDemo);
</script>

<style>
	.fx-flow {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-size: var(--fx-text-sm);
		line-height: 22px;
		text-align: start;
		color: var(--fx-text);

		--demo-b0: #0c1c2b;
		--demo-b1: #0f2233;
		--demo-b2: #152d42;
		--demo-flow: #ffd23f;
		--demo-flow-dash: #0f2233;
		--demo-shadow: 0 30px 80px rgb(0 0 0 / 0.5);
	}

	:global([data-theme="light"]) .fx-flow {
		--demo-b0: #f7f9fa;
		--demo-b1: #ffffff;
		--demo-b2: #eef2f5;
		--demo-flow: #0f2233;
		--demo-flow-dash: #ffd23f;
		--demo-shadow: 0 24px 60px rgb(15 34 51 / 0.16);
	}

	.frame {
		display: block;
		background: var(--demo-b1);
		border: 1px solid var(--fx-line);
		border-radius: 18px;
		overflow: hidden;
		box-shadow: var(--demo-shadow);
	}

	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px 16px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--fx-line);
		background: var(--demo-b0);
	}

	.file {
		font-family: var(--fx-font-mono);
		font-size: 13px;
		color: var(--fx-text-2);
	}

	.arrow {
		color: var(--fx-text-3);
	}

	.steps {
		margin: 0 auto;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}

	.step {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 36px;
		padding: 0 12px 0 6px;
		border: 1px solid var(--fx-line);
		border-radius: var(--fx-radius-pill);
		background: transparent;
		color: var(--fx-text-3);
		font: 600 13px / 18px var(--fx-font-body);
		cursor: pointer;
		transition:
			background-color 0.3s ease,
			color 0.3s ease;
	}

	.dot {
		width: 22px;
		height: 22px;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 12px;
		background: var(--demo-b2);
		color: var(--fx-text-2);
	}

	.step.past {
		color: var(--fx-text);
	}

	.step.past .dot {
		background: var(--fx-success);
		color: var(--demo-b1);
	}

	.step.cur {
		background: #ffd23f;
		border-color: #ffd23f;
		color: #0f2233;
	}

	.step.cur .dot {
		background: #0f2233;
		color: #ffd23f;
	}

	.controls {
		display: flex;
		gap: 6px;
	}

	.ctl {
		min-height: 36px;
		padding: 0 12px;
		border: 1px solid var(--fx-line-strong);
		border-radius: 8px;
		background: transparent;
		color: var(--fx-text);
		font: 600 13px / 18px var(--fx-font-body);
		cursor: pointer;
	}

	.ctl:hover {
		border-color: #ffd23f;
	}

	.ctl[hidden] {
		display: none;
	}

	.body {
		display: flex;
		flex-wrap: wrap;
		min-height: 420px;
	}

	.map {
		flex: 1.5 1 480px;
		min-width: 0;
		padding: 20px 20px 24px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.map-head,
	.row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 64px minmax(0, 1.2fr);
		gap: 10px;
		align-items: center;
	}

	.map-head {
		font-size: 12px;
		line-height: 16px;
		font-weight: 600;
		color: var(--fx-text-3);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding-bottom: 4px;
	}

	.rows {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.src {
		font-family: var(--fx-font-mono);
		font-size: 13px;
		padding: 9px 12px;
		border-radius: 8px;
		background: var(--demo-b2);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.wire {
		height: 2px;
		background: var(--fx-line);
		border-radius: 2px;
		position: relative;
		overflow: hidden;
	}

	.fill {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		width: 0%;
		background-color: var(--demo-flow);
		background-size: 16px 2px;
		transition: width 0.45s var(--fx-ease);
	}

	.row.on .fill {
		width: 100%;
	}

	.row.running .fill {
		background-image: linear-gradient(90deg, transparent 50%, var(--demo-flow-dash) 50%);
		animation: fx-march 0.5s linear infinite;
	}

	.dst {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 7px 10px;
		border-radius: 8px;
		border: 1.5px solid var(--fx-line);
		background: var(--demo-b1);
		opacity: 0.55;
		min-width: 0;
		transition:
			border-color 0.35s ease,
			opacity 0.35s ease;
	}

	.row.on .dst {
		border-color: #ffd23f;
		opacity: 1;
	}

	.dst-name {
		font-family: var(--fx-font-mono);
		font-size: 13px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.dst-type {
		font-size: 12px;
		color: var(--fx-text-3);
	}

	.ai {
		margin-inline-start: auto;
		font-size: 11px;
		line-height: 16px;
		font-weight: 700;
		padding: 1px 7px;
		border-radius: var(--fx-radius-pill);
		background: #ffd23f;
		color: #0f2233;
		display: none;
	}

	.row.on .ai {
		display: inline;
		animation: fx-in 0.35s ease both;
	}

	.side {
		flex: 1 1 320px;
		min-width: 0;
		padding: 20px 20px 24px;
		border-inline-start: 1px solid var(--fx-line);
		background: var(--demo-b0);
	}

	.panel {
		display: flex;
		flex-direction: column;
		gap: 14px;
		animation: fx-in 0.35s ease both;
	}

	.panel[hidden] {
		display: none;
	}

	.panel p {
		margin: 0;
		color: var(--fx-text-2);
	}

	.panel-title {
		font-family: var(--fx-font-display);
		font-weight: 600;
		font-size: 20px;
		line-height: 28px;
	}

	.sample {
		font-family: var(--fx-font-mono);
		font-size: 12px;
		line-height: 20px;
		color: var(--fx-text-2);
		background: var(--demo-b2);
		border-radius: 8px;
		padding: 10px 12px;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.stat-line {
		display: flex;
		justify-content: space-between;
		color: var(--fx-text-2);
	}

	.stat-n,
	.pct {
		font-family: var(--fx-font-mono);
		font-weight: 600;
		color: var(--fx-text);
	}

	.meter {
		display: block;
		height: 6px;
		border-radius: 6px;
		background: var(--demo-b2);
		overflow: hidden;
	}

	.meter.big {
		height: 8px;
	}

	.meter-fill {
		display: block;
		height: 100%;
		border-radius: inherit;
		transition: width 0.2s linear;
	}

	.meter-fill.ok,
	.run-fill {
		background: var(--fx-success);
	}

	.meter-fill.flow {
		background: var(--demo-flow);
	}

	.meter-fill.muted {
		background: var(--fx-text-3);
	}

	.run-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
	}

	.pct {
		color: var(--fx-success);
	}

	.rolling-back .pct {
		color: var(--fx-warning);
	}

	.rolling-back .run-fill {
		background: var(--fx-warning);
	}

	.log {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 8px;
		font-family: var(--fx-font-mono);
		font-size: 13px;
		line-height: 20px;
		color: var(--fx-text-2);
	}

	.log :global(li) {
		display: flex;
		gap: 10px;
		align-items: flex-start;
		animation: fx-in 0.35s ease both;
	}

	.log :global(svg) {
		flex: none;
		margin-top: 2px;
		color: var(--fx-success);
	}

	.rolling-back .log :global(svg) {
		color: var(--fx-warning);
	}

	.rollback {
		align-self: flex-start;
		min-height: 40px;
		padding: 0 14px;
		font-size: 14px;
		line-height: 20px;
	}

	figcaption {
		font-size: 14px;
		line-height: 20px;
		color: var(--fx-text-3);
		text-align: center;
	}

	@media (max-width: 560px) {
		.side {
			border-inline-start: 0;
			border-top: 1px solid var(--fx-line);
		}

		.map-head,
		.row {
			grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1.2fr);
		}
	}

	@keyframes fx-march {
		to {
			background-position: 16px 0;
		}
	}

	@keyframes fx-in {
		from {
			opacity: 0;
			transform: translateY(-8px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
