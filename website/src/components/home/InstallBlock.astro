---
// Install command with pnpm / npm / yarn tabs, a typing effect and copy (InstallBlock.dc.html).
// Rendered finished on the server, so it reads correctly without JavaScript; the script types
// it out once it scrolls into view, unless the visitor prefers reduced motion.
import { PACKAGE } from "../../site";

const managers = [
	{ id: "pnpm", command: `pnpm add ${PACKAGE}` },
	{ id: "npm", command: `npm install ${PACKAGE}` },
	{ id: "yarn", command: `yarn add ${PACKAGE}` },
];
const first = managers[0]!;
const uid = "fx-install";
---

<fx-install class="fx-install" data-commands={JSON.stringify(Object.fromEntries(managers.map((m) => [m.id, m.command])))}>
	<div class="tabs" role="tablist" aria-label="Package manager">
		{managers.map((m, i) => (
			<button
				type="button"
				role="tab"
				id={`${uid}-tab-${m.id}`}
				aria-selected={i === 0 ? "true" : "false"}
				aria-controls={`${uid}-panel`}
				tabindex={i === 0 ? 0 : -1}
				data-pm={m.id}
			>
				{m.id}
			</button>
		))}
		<span class="label" aria-hidden="true">terminal</span>
	</div>
	<div class="panel" id={`${uid}-panel`} role="tabpanel" aria-labelledby={`${uid}-tab-${first.id}`}>
		<div class="line">
			<code>
				<span class="prompt" aria-hidden="true">$ </span><span class="sr-only full">{first.command}</span><span class="typed" aria-hidden="true"><span class="pm">{first.id}</span><span class="rest">{first.command.slice(first.id.length)}</span></span><span class="caret" aria-hidden="true"></span>
			</code>
			<button type="button" class="copy" aria-label="Copy install command">
				<svg class="icon-copy" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 9h10v11H9zM5 15V4h10"></path></svg>
				<svg class="icon-done" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
				<span class="copy-text">Copy</span>
			</button>
		</div>
		<p class="next"># next: register the plugin in astro.config.mjs</p>
		<span class="sr-only" role="status" aria-live="polite"></span>
	</div>
</fx-install>

<script>
	const reduceMotion = () => matchMedia("(prefers-reduced-motion: reduce)").matches;

	class FxInstall extends HTMLElement {
		#commands: Record<string, string> = {};
		#pm = "pnpm";
		#n = 0;
		#timer: ReturnType<typeof setInterval> | undefined;
		#copyTimer: ReturnType<typeof setTimeout> | undefined;

		connectedCallback() {
			this.#commands = JSON.parse(this.dataset.commands ?? "{}");
			const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
			for (const tab of tabs) {
				tab.addEventListener("click", () => this.#select(tab.dataset.pm ?? "pnpm", true));
				tab.addEventListener("keydown", (event) => {
					const i = tabs.indexOf(tab);
					let next = -1;
					if (event.key === "ArrowRight") next = (i + 1) % tabs.length;
					else if (event.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
					else if (event.key === "Home") next = 0;
					else if (event.key === "End") next = tabs.length - 1;
					if (next < 0) return;
					event.preventDefault();
					tabs[next]!.focus();
					this.#select(tabs[next]!.dataset.pm ?? "pnpm", true);
				});
			}
			this.querySelector(".copy")?.addEventListener("click", () => this.#copy());
			this.#n = this.#command().length;
			this.#render();

			if (reduceMotion()) return;
			const io = new IntersectionObserver((entries) => {
				if (entries.some((e) => e.isIntersecting)) {
					io.disconnect();
					this.#type();
				}
			});
			io.observe(this);
		}

		disconnectedCallback() {
			clearInterval(this.#timer);
			clearTimeout(this.#copyTimer);
		}

		#command() {
			return this.#commands[this.#pm] ?? "";
		}

		#render() {
			const cmd = this.#command();
			const typed = cmd.slice(0, this.#n);
			const pm = this.querySelector<HTMLElement>(".pm");
			const rest = this.querySelector<HTMLElement>(".rest");
			const full = this.querySelector<HTMLElement>(".full");
			if (pm) pm.textContent = typed.slice(0, this.#pm.length);
			if (rest) rest.textContent = typed.slice(this.#pm.length);
			if (full) full.textContent = cmd;
			this.classList.toggle("done", this.#n >= cmd.length);
		}

		#type() {
			clearInterval(this.#timer);
			this.#n = 0;
			this.#render();
			this.#timer = setInterval(() => {
				if (this.#n >= this.#command().length) {
					clearInterval(this.#timer);
					return;
				}
				this.#n++;
				this.#render();
			}, 38);
		}

		#select(pm: string, animate: boolean) {
			this.#pm = pm;
			for (const tab of this.querySelectorAll<HTMLButtonElement>('[role="tab"]')) {
				const on = tab.dataset.pm === pm;
				tab.setAttribute("aria-selected", String(on));
				tab.tabIndex = on ? 0 : -1;
				if (on) this.querySelector('[role="tabpanel"]')?.setAttribute("aria-labelledby", tab.id);
			}
			this.classList.remove("copied");
			if (animate && !reduceMotion()) this.#type();
			else {
				clearInterval(this.#timer);
				this.#n = this.#command().length;
				this.#render();
			}
		}

		#copy() {
			const cmd = this.#command();
			navigator.clipboard?.writeText(cmd).catch(() => {});
			clearInterval(this.#timer);
			this.#n = cmd.length;
			this.#render();
			this.classList.add("copied");
			const status = this.querySelector('[role="status"]');
			const label = this.querySelector(".copy");
			const text = this.querySelector(".copy-text");
			if (status) status.textContent = "Copied";
			if (text) text.textContent = "Copied";
			label?.setAttribute("aria-label", "Copied");
			clearTimeout(this.#copyTimer);
			this.#copyTimer = setTimeout(() => {
				this.classList.remove("copied");
				if (status) status.textContent = "";
				if (text) text.textContent = "Copy";
				label?.setAttribute("aria-label", "Copy install command");
			}, 1600);
		}
	}
	customElements.define("fx-install", FxInstall);
</script>

<style>
	.fx-install {
		display: block;
		text-align: start;
		background: var(--fx-code-bg);
		border: 1px solid var(--fx-code-line);
		border-radius: var(--fx-radius-md);
		overflow: hidden;
		box-shadow: 0 16px 40px rgb(0 0 0 / 0.35);
	}

	:global([data-theme="light"]) .fx-install {
		box-shadow: 0 16px 40px rgb(15 34 51 / 0.18);
	}

	.tabs {
		display: flex;
		align-items: stretch;
		gap: 4px;
		padding: 0 8px;
		border-bottom: 1px solid #24425c;
	}

	[role="tab"] {
		font-family: var(--fx-font-mono);
		font-size: 13px;
		line-height: 20px;
		font-weight: 500;
		min-height: 44px;
		padding: 0 12px;
		border: 0;
		background: transparent;
		cursor: pointer;
		color: #93a7b7;
		box-shadow: inset 0 -2px 0 transparent;
		transition:
			color 0.2s ease,
			box-shadow 0.2s ease;
	}

	[role="tab"]:hover {
		color: #e6edf2;
	}

	[role="tab"][aria-selected="true"] {
		color: #ffffff;
		box-shadow: inset 0 -2px 0 #ffd23f;
	}

	.label {
		margin-inline-start: auto;
		align-self: center;
		font-family: var(--fx-font-mono);
		font-size: 12px;
		color: #8aa0b2;
	}

	.line {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 8px 10px 18px;
	}

	code {
		flex: 1 1 auto;
		min-width: 0;
		font-family: var(--fx-font-mono);
		font-size: 16px;
		line-height: 26px;
		color: #e6edf2;
		white-space: pre;
		overflow-x: auto;
		background: none;
		padding: 0;
		border: 0;
	}

	.prompt {
		color: #8aa0b2;
		user-select: none;
	}

	.pm {
		color: #ffd23f;
	}

	.caret {
		display: inline-block;
		width: 9px;
		height: 18px;
		margin-inline-start: 2px;
		vertical-align: -3px;
		background: #ffd23f;
		animation: fx-blink 1s steps(1) infinite;
	}

	.copy {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 44px;
		min-width: 44px;
		padding: 0 12px;
		border: 1px solid #3a5a76;
		border-radius: 8px;
		background: transparent;
		color: #e6edf2;
		font: 600 14px / 20px var(--fx-font-body);
		cursor: pointer;
		transition:
			background-color 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.copy:hover {
		border-color: #ffd23f;
	}

	.icon-done {
		display: none;
	}

	.copied .copy {
		background: #5fd39a;
		border-color: #5fd39a;
		color: #0f2233;
	}

	.copied .icon-copy {
		display: none;
	}

	.copied .icon-done {
		display: inline;
	}

	.next {
		margin: 0;
		padding: 0 18px 14px;
		font-family: var(--fx-font-mono);
		font-size: 13px;
		line-height: 20px;
		color: #8aa0b2;
		opacity: 1;
		transition: opacity 0.5s ease;
	}

	/* While typing, the hint waits for the command to finish. */
	.fx-install:not(.done) .next {
		opacity: 0;
	}

	.fx-install:not(:defined) .next {
		opacity: 1;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@keyframes fx-blink {
		50% {
			opacity: 0;
		}
	}
</style>
