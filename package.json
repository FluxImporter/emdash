{
	"name": "fluximporter-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.18.0",
	"engines": {
		"node": ">=22.16"
	},
	"scripts": {
		"typecheck": "pnpm -r --parallel typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "pnpm --filter @fluximporter/emdash test",
		"test:integration": "pnpm --filter @fluximporter/emdash test:integration",
		"test:cf": "pnpm --filter @fluximporter/emdash test:cf",
		"test:build": "pnpm --filter @fluximporter/emdash test:build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"typescript": "^5.9.0"
	}
}
