{
	"name": "@fluximporter/emdash",
	"version": "0.8.0",
	"description": "Import CSV, XML, JSON, spreadsheets, RSS feeds and WordPress exports into EmDash, with field mapping, dry runs, schedules and rollback.",
	"keywords": [
		"emdash",
		"emdash-plugin",
		"importer",
		"import",
		"csv",
		"json",
		"xml",
		"excel",
		"xlsx",
		"astro"
	],
	"homepage": "https://www.fluximporter.com/emdash/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FluxImporter/emdash.git",
		"directory": "packages/emdash"
	},
	"bugs": "https://github.com/FluxImporter/emdash/issues",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./astro/upload": "./src/astro/upload-route.ts",
		"./admin": "./src/admin/index.tsx"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./astro/upload": {
				"types": "./dist/astro/upload-route.d.ts",
				"default": "./dist/astro/upload-route.js"
			},
			"./admin": "./src/admin/index.tsx"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.admin.json",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:cf": "vitest run --config vitest.cf.config.ts",
		"test:build": "vitest run --config vitest.build.config.ts",
		"prepack": "pnpm typecheck && pnpm build"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "1.5.0",
		"@dnd-kit/core": "^6.3.1",
		"jsonata": "2.2.2",
		"luxon": "^3.7.2",
		"markdown-it": "14.3.3",
		"parse5": "7.3.0",
		"zod": "4.6.7"
	},
	"peerDependencies": {
		"@cloudflare/kumo": "2.19.0",
		"@emdash-cms/admin": "*",
		"@emdash-cms/auth": "^1.6.0",
		"@lingui/core": "*",
		"@lingui/react": "*",
		"@tanstack/react-query": "*",
		"astro": ">=6.0.0",
		"emdash": "^1.6.0",
		"kysely": "^0.29.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@astrojs/react": "^6.0.5",
		"@cloudflare/kumo": "2.19.0",
		"@emdash-cms/admin": "1.6.0",
		"@emdash-cms/auth": "1.6.0",
		"@lingui/core": "5.9.5",
		"@lingui/react": "5.9.5",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@tanstack/react-query": "5.90.21",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/luxon": "^3.7.0",
		"@types/markdown-it": "14.2.0",
		"@types/node": "^22.0.0",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"astro": "^7.3.2",
		"emdash": "1.6.0",
		"happy-dom": "21.0.4",
		"kysely": "^0.29.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"vitest": "^4.1.0"
	}
}
